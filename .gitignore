node_modules/
dist/
.DS_Store
.env
.env.*
!.env.example
public/vendor/

# Python bytecode from the turbo proxy (running `python -m py_compile app.py`
# locally, or the container importing it, drops these next to the source).
__pycache__/
*.py[cod]


# Firestore and Storage rules are version-controlled and deployed through
# firebase.json. Never ignore them: entitlement boundaries must be reviewable.
# Emulator runtime logs are generated locally and contain no deployable policy.
firestore-debug.log
firebase-debug.log
ui-debug.log


# Self-hosted Termux/private server. server.env holds the Telegram bot token,
# the Firebase service account and AI provider keys — the same values that are
# `sync: false` (dashboard-only) in render.yaml. Never commit it.
termux-server/server.env
termux-server/logs/
termux-server/.runtime/
termux-server/tunnel/cloudflared.yml
youtube-turbo-proxy/.venv/
