rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ════════════════════════════════════════════════════

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    // Admin check: doc existence in /admins/{uid} (written only from Console).
    function isAdmin() {
      return isLoggedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Billing / status guard (updates) ────────────────
    // Returns true only when the incoming write does NOT change any
    // admin-controlled field inside profile.*.
    function billingUnchanged() {
      let oldP = resource.data.get('profile', {});
      let newP = request.resource.data.get('profile', {});
      return newP.get('plan',             oldP.get('plan', 'free'))          == oldP.get('plan', 'free')
          && newP.get('planId',           oldP.get('planId', ''))            == oldP.get('planId', '')
          && newP.get('planExpiry',       oldP.get('planExpiry', ''))        == oldP.get('planExpiry', '')
          && newP.get('status',           oldP.get('status', 'pending'))     == oldP.get('status', 'pending')
          && newP.get('rejectReason',     oldP.get('rejectReason', ''))      == oldP.get('rejectReason', '')
          && newP.get('trialExpiry',      oldP.get('trialExpiry', ''))       == oldP.get('trialExpiry', '')
          && newP.get('trialDays',        oldP.get('trialDays', 0))          == oldP.get('trialDays', 0)
          && newP.get('trialSuspended',   oldP.get('trialSuspended', false)) == oldP.get('trialSuspended', false)
          && newP.get('referredBy',       oldP.get('referredBy', ''))        == oldP.get('referredBy', '')
          && newP.get('payoutPaidAmount', oldP.get('payoutPaidAmount', 0))   == oldP.get('payoutPaidAmount', 0)
          && newP.get('refPaidCount',     oldP.get('refPaidCount', 0))       == oldP.get('refPaidCount', 0)
          && newP.get('refTotalCount',    oldP.get('refTotalCount', 0))      == oldP.get('refTotalCount', 0);
    }

    // ── proTrial guard (updates) ─────────────────────────
    function proTrialUnchanged() {
      let oldAT = resource.data.get('appState', {});
      let newAT = request.resource.data.get('appState', {});
      let oldTrial = oldAT.get('proTrial', null);
      let newTrial = newAT.get('proTrial', null);
      return oldTrial == null
          || newTrial == oldTrial;
    }

    // ── Billing guard (create) ───────────────────────────
    function billingSafeOnCreate() {
      let p = request.resource.data.get('profile', {});
      return p.get('plan', 'free')            == 'free'
          && p.get('planId', '')              == ''
          && p.get('payoutPaidAmount', 0)     == 0
          && p.get('trialSuspended', false)   == false
          && (p.get('status', 'pending')      == 'pending'
           || p.get('status', 'approved')     == 'approved');
    }

    // ── Group membership helper ─────────────────────────
    // Check if the requesting user is a member of a group
    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.members != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // Check if the requesting user is the creator of a group
    function isGroupCreator(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    // ════════════════════════════════════════════════════
    //  COLLECTIONS
    // ════════════════════════════════════════════════════

    // ── Admin role collection ────────────────────────────
    match /admins/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // ── User documents ───────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && billingSafeOnCreate();
      allow update: if isAdmin()
                 || (isOwner(uid) && billingUnchanged() && proTrialUnchanged());
      allow delete: if isAdmin();
    }

    // ── Plans ────────────────────────────────────────────
    match /plans/{planId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Config (UPI, free limits, feature flags) ─────────
    match /config/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Payments ─────────────────────────────────────────
    match /payments/{payId} {
      allow create: if isLoggedIn()
        && request.resource.data.uid      == request.auth.uid
        && request.resource.data.amount   is number
        && request.resource.data.amount   >  0
        && request.resource.data.status   == 'pending'
        && request.resource.data.keys().hasAll(['uid', 'planId', 'amount', 'status', 'createdAt'])
        && exists(/databases/$(database)/documents/plans/$(request.resource.data.planId));

      allow read:   if isLoggedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Coupons ──────────────────────────────────────────
    match /coupons/{code} {
      allow read:          if isLoggedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || ( isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
          && request.resource.data.usedCount is number
          && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1 );
    }

    // ── Coupon redemptions (audit log) ───────────────────
    match /coupon_redemptions/{redemptionId} {
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
             'couponCode', 'uid', 'planId',
             'originalAmount', 'discountAmount', 'finalAmount',
             'createdAt'
           ])
        && request.resource.data.originalAmount is number
        && request.resource.data.originalAmount >  0
        && request.resource.data.discountAmount is number
        && request.resource.data.discountAmount >  0
        && request.resource.data.discountAmount <  request.resource.data.originalAmount
        && request.resource.data.finalAmount    is number
        && request.resource.data.finalAmount    >  0
        && request.resource.data.originalAmount
           == request.resource.data.discountAmount + request.resource.data.finalAmount
        && exists(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode));

      allow read:   if isLoggedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Feature / content requests ───────────────────────
    match /requests/{docId} {
      allow create: if isLoggedIn()
        && (!('uid' in request.resource.data)
         || request.resource.data.uid == request.auth.uid);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ── Referrals ────────────────────────────────────────
    match /referrals/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Payouts ──────────────────────────────────────────
    match /payouts/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Admin audit log ──────────────────────────────────
    match /admin_logs/{logId} {
      allow create:         if isAdmin();
      allow read:           if isAdmin();
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════
    //  STUDY GROUPS & LEADERBOARDS
    // ════════════════════════════════════════════════════

    // ── Study Groups ─────────────────────────────────────
    // Groups allow students to form study circles for accountability.
    // Public groups are discoverable; private groups require invite codes.
    match /groups/{groupId} {
      // Read: public groups OR groups where user is a member OR admin
      allow read: if isLoggedIn() && (
        resource.data.isPublic == true
        || request.auth.uid in resource.data.members
        || isAdmin()
      );

      // Create: any logged-in user can create a group
      allow create: if isLoggedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 100
        && request.resource.data.keys().hasAll(['name', 'examId', 'createdBy', 'members', 'isPublic', 'createdAt']);

      // Update: only creator OR admin can update group details
      // Members array can be modified by any member (for join/leave)
      allow update: if isAdmin()
        || isGroupCreator(groupId)
        || (isLoggedIn()
            && request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']));

      // Delete: only creator OR admin can delete
      allow delete: if isAdmin() || isGroupCreator(groupId);
    }

    // ── Group Stats (per-user weekly metrics) ────────────
    // Each user has one stats document per group per week.
    // Stats are used to compute leaderboards.
    match /groupStats/{statId} {
      // Read: any logged-in user (for leaderboard display)
      allow read: if isLoggedIn();

      // Create: user can create their own stats
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['groupId', 'uid', 'userName', 'weekStart']);

      // Update: user can update their own stats
      allow update: if isLoggedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      // Delete: only admin can delete
      allow delete: if isAdmin();
    }

    // ── Leaderboard Cache ────────────────────────────────
    // Precomputed leaderboards for fast reads.
    // Only Cloud Functions or admin can write.
    match /leaderboardCache/{cacheId} {
      // Read: any logged-in user
      allow read: if isLoggedIn();

      // Write: only admin (Cloud Functions use admin SDK)
      allow write: if isAdmin();
    }

    // ── Group Invites ────────────────────────────────────
    // Track invite codes for private groups
    match /groupInvites/{inviteCode} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['groupId', 'createdBy', 'createdAt', 'expiresAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // ── Global Leaderboards (per exam) ───────────────────
    // Precomputed global leaderboards for each exam
    match /globalLeaderboard/{examWeekId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
