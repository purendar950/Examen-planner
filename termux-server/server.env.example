# ═══════════════════════════════════════════════════════════════════════════
# Copy to server.env and fill in. server.env is gitignored — never commit it.
#
#   cp server.env.example server.env && nano server.env
#
# This one file replaces the Render dashboard for BOTH services. start-all.sh
# sources it and then hands each process only the PORT it needs.
# ═══════════════════════════════════════════════════════════════════════════

# ── Ports and binding ──────────────────────────────────────────────────────
# NOTE: do NOT set a bare `PORT` here. The proxy and the bot both read PORT and
# would collide on the same value; start-all.sh sets PORT per-process from
# these two variables instead.
export PROXY_PORT=8080          # youtube-turbo-proxy (Flask/gunicorn)
export BOT_PORT=3000            # examzen-telegram-bot (node)
# Keep this on loopback. The tunnel reaches it locally; opening it to the LAN
# or the internet exposes an unauthenticated-at-the-edge API.
export BIND=127.0.0.1

# ── Process sizing (tuned for a phone) ─────────────────────────────────────
export WEB_WORKERS=1            # one worker; raise only if you have RAM spare
export WEB_THREADS=2
export WEB_TIMEOUT=600          # long AI/study requests need this
export WEB_GRACEFUL_TIMEOUT=30
export NODE_OPTIONS="--max-old-space-size=192"
export DENO_V8_FLAGS="--max-old-space-size=96"
export MAX_CONCURRENT_EXTRACT=1 # yt-dlp extraction is the memory spike

# Where the writable YouTube cookie copy lives. Defaults to the system temp dir
# (which honours $TMPDIR); set it explicitly to survive temp-dir cleaning.
export COOKIE_CACHE_DIR=/opt/examzen-state

# ── Shared: Firebase (REQUIRED for both services) ──────────────────────────
# The SAME service-account JSON both Render services already use. Keep the file
# outside the repo. This is what verifies browser Firebase ID tokens and reads
# Firestore config/ai, config/aiLimits and config/turbo.
export FIREBASE_SERVICE_ACCOUNT="$(cat /opt/examzen-secrets/firebase-service-account.json)"

# ── Shared: CORS ───────────────────────────────────────────────────────────
# Built-in defaults (examzen.in, www.examzen.in, purendar950.github.io,
# appassets.androidengine) are ALWAYS allowed — this only ADDS to them.
# Never use a wildcard.
# export ALLOWED_ORIGINS="https://your-extra-origin.example"

# ── Telegram bot ───────────────────────────────────────────────────────────
export TELEGRAM_BOT_TOKEN="replace-me"
export APP_BASE_URL="https://purendar950.github.io/Examen-planner"
export NODE_ENV=production
# Derived from the service account when unset; set explicitly to keep signed
# media URLs valid across a service-account rotation.
# export TELEGRAM_MEDIA_SIGNING_SECRET="replace-me"

# ── YouTube cookies (proxy) ────────────────────────────────────────────────
# Primary source is Firestore config/turbo, managed from the admin panel. This
# is the fallback. Use a THROWAWAY account — cookies are full account access.
# export YT_COOKIES="$(cat /opt/examzen-secrets/youtube-cookies.txt)"
export COOKIE_REFRESH_SEC=600

# ── Media/extraction tuning (proxy) ────────────────────────────────────────
export MAX_HEIGHT=720
export CACHE_TTL=18000
# auto = use Deno if installed, else Node (needs Node >= 22).
export YTDLP_JS_RUNTIME=auto

# ── AI provider keys (proxy) ───────────────────────────────────────────────
# All optional: Firestore config/ai is the primary source and the admin panel
# manages it. These are env fallbacks for when Firestore is unreachable.
# export BYNARA_API_KEY="replace-me"
# export GROQ_API_KEY="replace-me"
# export GITHUB_TOKEN="replace-me"          # AI Chat GitHub repo/file reads
# export TAVILY_API_KEY="replace-me"        # web search
# export BRAVE_API_KEY="replace-me"
# export SERPER_API_KEY="replace-me"

# ── S3-compatible storage for study bodies (proxy, optional) ───────────────
# Keeps large notes out of Firestore's 1 MiB/doc limit. All four non-region
# values must be set or the proxy silently falls back to Firestore-only.
# export S3_ENDPOINT_URL="https://s3.us-west-000.backblazeb2.com"
# export S3_REGION="us-west-000"
# export S3_BUCKET="examzen-study"
# export S3_ACCESS_KEY_ID="replace-me"
# export S3_SECRET_ACCESS_KEY="replace-me"

# ── Supabase pgvector for AI-Tutor memory (proxy, optional) ────────────────
# Must be the SERVICE key: note_chunks has RLS enabled with no policies, so an
# anon key is rejected on purpose.
# export MEMORY_SUPA_URL="https://aqxglvtndssjkqluvzpl.supabase.co"
# export MEMORY_SUPA_SERVICE_KEY="replace-me"
# EMBED_DIM must match note_chunks.embedding vector(768) in supabase/note_chunks.sql
# export EMBED_DIM=768

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────
# Named mode has a permanent hostname and takes precedence when configured.
export TUNNEL_NAME=""
export TUNNEL_CONFIG="/opt/examzen/termux-server/tunnel/cloudflared.yml"

# No-domain mode: start a random Quick Tunnel for the proxy, verify it, and
# transactionally publish each new URL to Firestore config/turbo. Browser
# clients receive it automatically and prefer it in manual mode, with Render
# retained as fallback. The Telegram browser relay remains on Render.
export QUICK_TUNNEL=0
export QUICK_TUNNEL_ACTIVATE_ROLES="media,ai"
