# Source this file from start.sh. Keep private.env out of Git.

export PORT=8080
export BIND=127.0.0.1
export WEB_WORKERS=1
export WEB_THREADS=2

# Existing defaults include GitHub Pages. Add exact custom origins only.
# export ALLOWED_ORIGINS="https://purendar950.github.io"

# Required for authenticated Study AI endpoints and Firestore-managed config.
# Replace the path with your service-account JSON outside this repository.
# export FIREBASE_SERVICE_ACCOUNT="$(cat "$HOME/.config/examzen/firebase-service-account.json")"

# Fallback when Firestore cookie sync is unavailable. Use a throwaway account.
# export YT_COOKIES="$(cat "$HOME/.config/examzen/youtube-cookies.txt")"

# Environment fallbacks used when Firestore config/ai is unavailable.
# export BYNARA_API_KEY="replace-me"
# export GROQ_API_KEY="replace-me"

# Memory ceilings are conservative for phones and 512 MB-class hosts.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=128}"
export DENO_V8_FLAGS="${DENO_V8_FLAGS:---max-old-space-size=96}"
